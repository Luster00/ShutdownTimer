<Window x:Class="ShutdownTimer.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="430" Height="390"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <Color x:Key="BgTopColor">#212C2E</Color>
        <Color x:Key="BgBottomColor">#1B2123</Color>
        <Color x:Key="AccentColor">#759197</Color>
        <Color x:Key="Accent2Color">#7E9397</Color>
        <Color x:Key="OnAccentColor">#0B1B1E</Color>
        <Color x:Key="TextColor">#EAF1F2</Color>
        <Color x:Key="TextSoftColor">#C9D6D9</Color>
        <Color x:Key="TextMutedColor">#8CA0A5</Color>
        <Color x:Key="SurfaceColor">#A60B1B1E</Color>
        <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}"/>
        <SolidColorBrush x:Key="TextSoftBrush" Color="{StaticResource TextSoftColor}"/>
        <SolidColorBrush x:Key="TextMutedBrush" Color="{StaticResource TextMutedColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}"/>
        <LinearGradientBrush x:Key="CardBrush" StartPoint="0,0" EndPoint="0.6,1">
            <GradientStop Color="{StaticResource BgTopColor}" Offset="0"/>
            <GradientStop Color="{StaticResource BgBottomColor}" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="GoBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="{StaticResource AccentColor}" Offset="0"/>
            <GradientStop Color="{StaticResource Accent2Color}" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="OnAccentBrush" Color="{StaticResource OnAccentColor}"/>
        <Style x:Key="SoftButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="Padding" Value="14,9"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="12" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.86"/></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.68"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Choice" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="bd" Background="{StaticResource SurfaceBrush}" CornerRadius="13" Padding="14,11" Margin="0,0,8,0">
                            <ContentPresenter HorizontalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True"><Setter TargetName="bd" Property="Background" Value="{StaticResource GoBrush}"/><Setter Property="Foreground" Value="{StaticResource OnAccentBrush}"/></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="bd" Property="Opacity" Value="0.88"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="Toggle" TargetType="CheckBox">
            <Setter Property="Foreground" Value="{StaticResource TextSoftBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="track" Width="48" Height="27" CornerRadius="14" Background="#3A4A4D">
                                <Ellipse x:Name="knob" Width="21" Height="21" Fill="{StaticResource TextBrush}" HorizontalAlignment="Left" Margin="3,0,0,0"/>
                            </Border>
                            <ContentPresenter Margin="12,0,0,0" VerticalAlignment="Center"/>
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="track" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="knob" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="knob" Property="Margin" Value="0,0,3,0"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="0">
        <Border CornerRadius="24" Background="{StaticResource CardBrush}" BorderBrush="#33759197" BorderThickness="1">
            <Grid Margin="26">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Margin="0,0,0,24" MouseLeftButtonDown="TitleBar_Drag">
                    <StackPanel>
                        <TextBlock x:Name="TitleText" Text="Settings" FontSize="24" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}"/>
                        <TextBlock x:Name="HintText" Text="Changes are saved automatically." Margin="0,5,0,0" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                    </StackPanel>
                    <Button Style="{StaticResource SoftButton}" Content="✕" Width="34" Height="30" Padding="0" HorizontalAlignment="Right" Click="Close_Click"/>
                </Grid>

                <TextBlock x:Name="LanguageLabel" Grid.Row="1" Text="Language" FontSize="13" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,8"/>
                <UniformGrid Grid.Row="2" Columns="3">
                    <RadioButton x:Name="AutoLanguage" Style="{StaticResource Choice}" Content="Automatic" Click="Language_Click" Tag="auto"/>
                    <RadioButton x:Name="RussianLanguage" Style="{StaticResource Choice}" Content="Русский" Click="Language_Click" Tag="ru"/>
                    <RadioButton x:Name="EnglishLanguage" Style="{StaticResource Choice}" Content="English" Click="Language_Click" Tag="en"/>
                </UniformGrid>

                <StackPanel Grid.Row="3" VerticalAlignment="Center">
                    <CheckBox x:Name="AutoStartToggle" Style="{StaticResource Toggle}" Content="Start with Windows" IsChecked="False" Click="AutoStart_Click"/>
                    <TextBlock x:Name="AutoStartHint" Text="Launch Shutdown Timer automatically after you sign in to Windows." Margin="60,7,0,0" TextWrapping="Wrap" FontSize="12" Foreground="{StaticResource TextMutedBrush}"/>
                </StackPanel>

                <Button Grid.Row="4" x:Name="CloseButton" Style="{StaticResource SoftButton}" Content="Done" Background="{StaticResource GoBrush}" Foreground="{StaticResource OnAccentBrush}" HorizontalAlignment="Right" MinWidth="90" Click="Close_Click"/>
            </Grid>
        </Border>
    </Grid>
</Window>
